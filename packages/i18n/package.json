{
  "name": "@regle-rules/i18n",
  "version": "0.2.2",
  "description": "i18n translations for Regle rules",
  "homepage": "https://github.com/asip/regle-rules#readme",
  "bugs": {
    "url": "https://github.com/asip/regle-rules/issues"
  },
  "license": "MIT",
  "author": "Yasumasa Ashida <ys.ashida@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asip/regle-rules.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint --fix './src/**/*.{js,ts}'",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@regle/core": "^1.30.1",
    "@regle/rules": "^1.30.1",
    "vue-i18n": "^11.4.24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "oxfmt": "^0.80.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3 || ^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
